<Window x:Class="SnapAnchor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapAnchor" Icon="pack://application:,,,/SnapAnchor;component/Assets/SnapAnchor-icon-512.png"
        Height="780" Width="1100" MinHeight="600" MinWidth="900"
        Background="{DynamicResource PageBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}"/>
        <Style TargetType="TextBox" BasedOn="{StaticResource AppTextBoxStyle}"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AppComboBoxStyle}"/>
        <Style x:Key="NavigationIcon" TargetType="Path">
            <Setter Property="Width" Value="16"/><Setter Property="Height" Value="16"/><Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
            <Setter Property="StrokeThickness" Value="1.5"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid Background="{DynamicResource PageBrush}"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="166"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border BorderBrush="{DynamicResource NeutralBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="10,22,10,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,24">
                    <Image x:Name="AppLogoImage" Source="pack://application:,,,/SnapAnchor;component/Assets/SnapAnchor-icon-512.png" Width="26" Height="26" Margin="0,0,9,0"/>
                    <TextBlock Text="SnapAnchor" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Text="Capture · annotate · pin" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="12,18,0,0"/>
                <StackPanel>
                    <RadioButton x:Name="WorkspaceNavigation" AutomationProperties.Name="Workspace" GroupName="Navigation" Tag="workspace" Checked="Navigation_Checked" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="M2,2 H9 V9 H2 Z M15,2 H22 V9 H15 Z M2,15 H9 V22 H2 Z M15,15 H22 V22 H15 Z" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Workspace"/></StackPanel></RadioButton>
                    <RadioButton x:Name="PinsNavigation" AutomationProperties.Name="Pins" GroupName="Navigation" Tag="pins" Checked="Navigation_Checked" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ToolbarPinIcon}" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Pins"/></StackPanel></RadioButton>
                    <RadioButton x:Name="HistoryNavigation" AutomationProperties.Name="History" GroupName="Navigation" Tag="history" Checked="Navigation_Checked" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="M4,8 A9,9 0 1 1 3,15 M4,3 V8 H9 M12,7 V12 L16,14" Style="{StaticResource NavigationIcon}"/><TextBlock Text="History"/></StackPanel></RadioButton>
                    <RadioButton x:Name="SettingsNavigation" AutomationProperties.Name="Settings" GroupName="Navigation" Tag="settings" Checked="Navigation_Checked" Style="{StaticResource NavigationButtonStyle}"><StackPanel Orientation="Horizontal"><Path Data="M4,5 H20 M4,12 H20 M4,19 H20 M8,2 V8 M16,9 V15 M10,16 V22" Style="{StaticResource NavigationIcon}"/><TextBlock Text="Settings"/></StackPanel></RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid x:Name="PageLayout" Grid.Column="1" Margin="24,24,24,18" SizeChanged="PageLayout_SizeChanged">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel x:Name="PageHeading" Margin="0,0,0,16" HorizontalAlignment="Left"><TextBlock x:Name="PageTitle" Text="Workspace" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="PageDescription" Text="Your recent captures, ready to copy, edit or pin." Foreground="{DynamicResource MutedBrush}" Margin="0,5,0,0" FontSize="13"/></StackPanel>
            <WrapPanel x:Name="CaptureActions" Grid.Row="1" Margin="0,0,0,20">
                <Button x:Name="CaptureButton" AutomationProperties.Name="Capture region" Click="CaptureButton_Click" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ToolbarRecaptureIcon}" Style="{StaticResource ToolbarIconPathStyle}" Margin="0,0,8,0"/><TextBlock x:Name="CaptureLabel" Text="Capture region"/><TextBlock x:Name="CaptureKeyLabel" Text="Print Screen" FontSize="11" Margin="12,2,0,0" Opacity="0.85"/></StackPanel></Button>
                <Button x:Name="PinClipboardButton" AutomationProperties.Name="Pin clipboard" Click="PinButton_Click" Margin="0,0,8,4"><StackPanel Orientation="Horizontal"><Path Data="{StaticResource ToolbarPinIcon}" Style="{StaticResource ToolbarIconPathStyle}" Margin="0,0,8,0"/><TextBlock Text="Pin clipboard"/><TextBlock x:Name="PinKeyLabel" Text="F3" FontSize="11" Margin="12,2,0,0" Foreground="{DynamicResource MutedBrush}"/></StackPanel></Button>
                <Button Content="More tools" Click="MoreTools_Click" Style="{StaticResource QuietButtonStyle}" Margin="0,0,0,4">
                    <Button.ContextMenu><ContextMenu>
                        <MenuItem Header="Capture active window" Click="ActiveWindow_Click"/>
                        <MenuItem Header="Capture full screen" Click="FullScreen_Click"/>
                        <MenuItem Header="Custom capture" Click="CustomCapture_Click"/>
                        <MenuItem Header="Repeat last region" Click="RepeatRegion_Click"/>
                        <Separator/><MenuItem Header="Draw on screen" Click="DrawScreenButton_Click"/>
                        <MenuItem Header="Record region" Click="RecordRegion_Click"/>
                        <MenuItem Header="Colour picker" Click="ColourPicker_Click"/>
                        <Separator/><MenuItem Header="Whiteboard" Click="Whiteboard_Click"/>
                        <MenuItem Header="Transparent whiteboard" Click="TransparentWhiteboard_Click"/>
                    </ContextMenu></Button.ContextMenu>
                </Button>
            </WrapPanel>
            <ContentControl x:Name="PageHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            <Grid x:Name="PinsPane" Grid.Row="2" Visibility="Collapsed">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <WrapPanel Margin="0,0,0,12">
                    <TextBlock Text="Group" VerticalAlignment="Center" Margin="0,0,8,4"/>
                    <ComboBox x:Name="PinGroupsCombo" Width="145" SelectionChanged="PinGroup_SelectionChanged" Margin="0,0,8,4"/>
                    <TextBox x:Name="NewPinGroupBox" Width="145" ToolTip="New group name" Margin="0,0,5,4"/>
                    <Button Content="+" Click="AddPinGroup_Click" Width="36" Padding="0" ToolTip="Add group" Margin="0,0,5,4"/>
                    <Button Content="−" Click="DeletePinGroup_Click" Width="36" Padding="0" ToolTip="Delete current group" Margin="0,0,10,4"/>
                    <TextBlock x:Name="PinManagerStatus" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,4"/>
                </WrapPanel>
                <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                    <Button Content="Hide / show" Click="ToggleManagedPins_Click" Margin="0,0,6,4"/>
                    <Button Content="Link desktop" Click="BindPinGroupDesktop_Click" Margin="0,0,6,4"/>
                    <Button Content="Remove link" Click="ClearPinGroupDesktop_Click" Margin="0,0,6,4"/>
                    <Button Content="Close group" Click="CloseManagedPins_Click" Style="{StaticResource QuietButtonStyle}" Margin="0,0,0,4"/>
                </WrapPanel>
                <TextBlock x:Name="PinDesktopStatus" Grid.Row="2" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
                <ListBox x:Name="PinManagerList" Grid.Row="3" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource GalleryItemStyle}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemTemplate><DataTemplate>
                        <StackPanel Width="208"><Border Height="124" Background="{DynamicResource ThumbnailBrush}" CornerRadius="7,7,0,0" ClipToBounds="True" Padding="8"><Image Source="{Binding Image}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/></Border>
                            <Grid Margin="10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding SizeLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding VisibilityLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
                                <Button Grid.Column="1" Tag="{Binding Id}" Click="ActivateManagedPin_Click" Padding="8" ToolTip="Show this pin" Style="{StaticResource QuietButtonStyle}"><Path Data="{StaticResource ToolbarPinThumbnailIcon}" Style="{StaticResource ToolbarIconPathStyle}"/></Button>
                                <Button Grid.Column="2" Tag="{Binding Id}" Click="CloseManagedPin_Click" Padding="8" ToolTip="Close this pin" Style="{StaticResource QuietButtonStyle}"><Path Data="{StaticResource ToolbarCancelIcon}" Style="{StaticResource ToolbarIconPathStyle}"/></Button>
                            </Grid>
                        </StackPanel>
                    </DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Grid>
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource NeutralBrush}" BorderThickness="0,1,0,0" Padding="16,8">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Global shortcuts are ready" FontSize="12" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/></StackPanel>
                <TextBlock Grid.Column="1" Text="Alt+Shift+P restores click-through pins" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="14,0,0,0" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
