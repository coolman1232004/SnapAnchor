<UserControl x:Class="SnapAnchor.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Button Click="Choose_Click" Padding="7" Margin="0,0,6,0" ToolTip="Choose color" AutomationProperties.Name="Choose color">
            <Border x:Name="Swatch" Width="20" Height="20" CornerRadius="3" BorderBrush="{DynamicResource NeutralBrush}" BorderThickness="1"/>
        </Button>
        <TextBox x:Name="ValueBox" Grid.Column="1" Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Color (ARGB)"/>
    </Grid>
</UserControl>
